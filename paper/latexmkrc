# latexmkrc -- latexmk settings for the paper (also read by Overleaf).
# The reference list is embedded in flash_v1.tex, so latexmk only reruns
# pdflatex until the citation numbers settle. latexmk needs Perl.
@default_files = ('flash_v1.tex');
$pdf_mode = 1;
$pdflatex = 'pdflatex -interaction=nonstopmode -file-line-error -synctex=1 %O %S';
