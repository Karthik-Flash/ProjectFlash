# ---- Vivado projects and build scratch -------------------------------------
# All Vivado projects, logs and scratch runs live under verilog/ and are
# regenerated from v1/ by the scripts in v1/scripts/. Only the README that
# says which project is which is tracked.
/verilog/*
!/verilog/README.md

# Vivado / xsim byproducts wherever they land
*.jou
*.log
*.str
.Xil/
vivado*/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.gen/
*.xpr
xsim.dir/
webtalk*
*.vcd
*.wdb
*.vvp
# Vivado's PS7 IP writes NA/ps7_summary.html into the batch working directory
/NA/

# ---- FPGA implementation outputs ---------------------------------------------
# Regenerable from the Vivado project; not committed in general ...
*.bit
*.bin
*.mcs
*.prm
*.ltx
*.dcp
*.rpt
*.pb
# ... except the board overlays and the reports kept as evidence of a run.
!v1/board/flash_hp*.bit
!docs/**/*.rpt

# ---- Python / Colab ----------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/
*.zip
flash_v0_mem/

# ML training artefacts and datasets: only exported .mem weights and small
# test vectors belong in git.
*.pth
*.pt
*.h5
*.ckpt
*.onnx
*.npz
checkpoints/
wandb/
runs/
data/
datasets/

# V1 export: everything under v1/mem/ is regenerable from colab/ProjectFlash_V1.ipynb.
# Commit only the small files the RTL and the board need; drop the bulk vectors.
flash_v1/
flash_v1_*.zip
flash_v1_1_smoke_export_28x28
v1/mem/*/*/vectors/img_*.mem
v1/mem/*/*/vectors/trace/
v1/mem/*/*/model_state.pt
v1/mem/*/*/report/
v1/mem/*/ProjectFlash_V1_*.ipynb
v1/mem/smoke_28/
v1/mem/v1_0/
verilog_v1/
v1/vivado/

# Board bundle, assembled locally by v1/board/make_board_bundle.ps1
board_bundle/

# ---- OS / editor ---------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
